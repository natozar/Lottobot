rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // v119: quem e admin fica decidido aqui, por identidade, e nao por um
    // campo gravavel no banco. Antes bastava ter isAdmin:true no proprio
    // documento para virar admin — e o documento e escrito pelo cliente.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['chatsagrado@gmail.com', 'agrorv@gmail.com']
        || request.auth.token.phone_number == '+5516999916690'
      );
    }

    // Users: own data only, admin can read all
    // Plan fields (plano, planoExpira, planoCiclo, mpSubscriptionId, planoHistorico)
    // can only be written by Cloud Functions (admin SDK)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plano', 'planoExpira', 'planoCiclo', 'mpSubscriptionId', 'planoHistorico']);
      allow read: if isAdmin();

      match /savedGames/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        // Regras de subcolecao nao herdam do documento pai.
        allow read: if isAdmin();
      }
    }

    // Lotes de combinacoes geradas (salvas ou nao) — usados para analise.
    // O cliente so cria o proprio lote; nao le e nao edita.
    match /generatedBatches/{id} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      // Ninguem edita um lote depois de criado (o registro tem que ser fiel).
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Vitorias detectadas pela Cloud Function — escrita so pelo Admin SDK.
    match /wins/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Draws: read-only for clients
    match /draws/{drawId} {
      allow read: if request.auth != null;
    }

    // Blog posts: readable by all (SSR function reads via admin SDK anyway)
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // Config: readable by all auth users (o app le config/pix), writable by admin
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Aparelhos autorizados a abrir o painel. Colecao propria de proposito:
    // /config e legivel por qualquer usuario logado e esta lista nao pode ser.
    match /adminDevices/{deviceId} {
      allow read, write: if isAdmin();
    }

    // Notifications: admin only
    match /notifications/{id} {
      allow read, write: if isAdmin();
    }

    // Bets odds: readable by all auth users, writable only by Cloud Functions
    match /bets_odds/{sportKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bets meta: readable by admin only
    match /bets_meta/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
