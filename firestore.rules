rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: own data only, admin can read all
    // Plan fields (plano, planoExpira, planoCiclo, mpSubscriptionId, planoHistorico)
    // can only be written by Cloud Functions (admin SDK)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['plano', 'planoExpira', 'planoCiclo', 'mpSubscriptionId', 'planoHistorico']);
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      match /savedGames/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        // Regras de subcolecao nao herdam do documento pai: sem esta linha o
        // admin le /users mas recebe permission-denied em /savedGames.
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }
    }

    // Lotes de combinacoes geradas (salvas ou nao) — usados para analise.
    // O cliente so cria o proprio lote; nao le, nao edita e nao apaga.
    // Sem este bloco o Firestore negava por padrao e todo o logging de
    // logGeneratedGames() falhava em silencio.
    match /generatedBatches/{id} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      // Ninguem edita um lote depois de criado (o registro tem que ser fiel).
      // O admin pode apagar, para limpar testes e dados antigos.
      allow update: if false;
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Vitorias detectadas pela Cloud Function — leitura so do admin,
    // escrita apenas pelo Admin SDK (Cloud Functions ignoram estas regras).
    match /wins/{id} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow write: if false;
    }

    // Draws: read-only for clients
    match /draws/{drawId} {
      allow read: if request.auth != null;
    }

    // Blog posts: readable by all (SSR function reads via admin SDK anyway)
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // Config: readable by all auth users, writable by admin
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Notifications: admin only
    match /notifications/{id} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Bets odds: readable by all auth users, writable only by Cloud Functions
    match /bets_odds/{sportKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bets meta: readable by admin only
    match /bets_meta/{doc} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow write: if false;
    }
  }
}
